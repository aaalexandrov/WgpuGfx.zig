+// Zig 0.17: std.Thread.sleep was removed; poll with libc nanosleep instead.
+inline fn pollSleep(nanoseconds: u64) void {
+    var req = std.c.timespec{
+        .sec = @intCast(nanoseconds / std.time.ns_per_s),
+        .nsec = @intCast(nanoseconds % std.time.ns_per_s),
+    };
